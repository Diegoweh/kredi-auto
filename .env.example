# Appwrite Cloud → Settings → API credentials
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Server API key with scopes: databases, tables, rows, buckets, files, users, sessions
APPWRITE_API_KEY=

# Public URL of the site (used in WhatsApp messages and metadata)
NEXT_PUBLIC_SITE_URL=https://krediautomzt.mx

# Only used by `npm run appwrite:setup` to create the first admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=
